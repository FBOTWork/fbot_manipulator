format: xrdf
format_version: 1.0

# wx200 (Interbotix WidowX 200, 5 DOF) + the stock 2-finger gripper, for
# NVIDIA Isaac ROS cuMotion (see fbot_manipulator/docs/cuda_planning_setup.md).
#
# Link/joint names and geometry were measured from the actual URDF generated by
# interbotix_xsarm_descriptions/urdf/wx200.urdf.xacro (robot_name:=wx200, which is why
# every link is prefixed "wx200/" -- joints are not). Collision-sphere placement was derived
# from each mesh's real bounding box (parsed from the .stl files directly, not guessed), but
# is still an approximation, not a certified exact fit -- treat the radii as a cautious
# starting point and tighten/loosen them after watching real plans in RViz.
#
# NOT measured / verified against hardware:
#  - default_joint_positions: an arbitrary mid-range seed within the real joint limits, not
#    the robot's actual "home"/"sleep" pose. Only affects cuRobo's optimizer seed, not safety.
#  - cspace.jerk_limits: nothing else in this stack defines jerk (OMPL doesn't use it either),
#    so this is a generic placeholder, not a measured Dynamixel spec.
#  - acceleration_limits ARE real: copied from interbotix_xsarm_moveit's
#    config/joint_limits/wx200_joint_limits.yaml (max_acceleration: 10.0 for all 5 joints).

modifiers:
  - set_base_frame: "wx200/base_link"

default_joint_positions:
  waist: 0.0
  shoulder: -0.8
  elbow: 0.5
  wrist_angle: 0.3
  wrist_rotate: 0.0

cspace:
  joint_names:
    - "waist"
    - "shoulder"
    - "elbow"
    - "wrist_angle"
    - "wrist_rotate"
  acceleration_limits: [10.0, 10.0, 10.0, 10.0, 10.0]
  jerk_limits: [50.0, 50.0, 50.0, 50.0, 50.0]

tool_frames: ["wx200/ee_gripper_link"]

collision:
  geometry: "wx200_gripper_collision_spheres"
  buffer_distance:
    wx200/base_link: 0.005
    wx200/shoulder_link: 0.005
    wx200/upper_arm_link: 0.005
    wx200/forearm_link: 0.005
    wx200/wrist_link: 0.005
    wx200/gripper_link: 0.005
    wx200/gripper_bar_link: 0.005
    wx200/gripper_prop_link: 0.005
    wx200/left_finger_link: 0.003
    wx200/right_finger_link: 0.003

self_collision:
  geometry: "wx200_gripper_collision_spheres"
  buffer_distance:
    wx200/shoulder_link: 0.01
    wx200/gripper_bar_link: 0.01
  ignore:
    wx200/base_link: ["wx200/shoulder_link"]
    wx200/shoulder_link: ["wx200/upper_arm_link"]
    wx200/upper_arm_link: ["wx200/forearm_link"]
    wx200/forearm_link: ["wx200/wrist_link"]
    wx200/wrist_link: ["wx200/gripper_link"]
    wx200/gripper_link: ["wx200/gripper_bar_link", "wx200/gripper_prop_link"]
    wx200/gripper_bar_link: ["wx200/gripper_prop_link", "wx200/left_finger_link", "wx200/right_finger_link"]
    wx200/gripper_prop_link: ["wx200/left_finger_link", "wx200/right_finger_link"]
    wx200/left_finger_link: ["wx200/right_finger_link"]

geometry:
  wx200_gripper_collision_spheres:
    spheres:
      # Base plate. Fixed to world -- only matters for other links getting too close to it.
      wx200/base_link:
        - center: [-0.09, 0.0, 0.036]
          radius: 0.075
        - center: [0.03, 0.0, 0.036]
          radius: 0.075

      wx200/shoulder_link:
        - center: [0.0, 0.0, 0.023]
          radius: 0.06

      # Long link along local +Z (elbow joint sits at z=0.2 in this frame).
      wx200/upper_arm_link:
        - center: [0.015, 0.0, 0.0]
          radius: 0.05
        - center: [0.015, 0.0, 0.1]
          radius: 0.045
        - center: [0.015, 0.0, 0.19]
          radius: 0.045

      # Long link along local +X (wrist_angle joint sits at x=0.2 in this frame).
      wx200/forearm_link:
        - center: [0.02, 0.0, 0.0]
          radius: 0.035
        - center: [0.1, 0.0, 0.0]
          radius: 0.03
        - center: [0.185, 0.0, 0.0]
          radius: 0.03

      wx200/wrist_link:
        - center: [0.0, 0.0, 0.008]
          radius: 0.035
        - center: [0.05, 0.0, 0.008]
          radius: 0.03

      wx200/gripper_link:
        - center: [0.02, 0.0, 0.008]
          radius: 0.035

      # Spans across to both finger rails -- three spheres (left / center / right).
      wx200/gripper_bar_link:
        - center: [0.01, -0.035, 0.01]
          radius: 0.025
        - center: [0.01, 0.0, 0.01]
          radius: 0.03
        - center: [0.01, 0.035, 0.01]
          radius: 0.025

      # Servo horn that drives the fingers -- small, not part of cspace (held at its URDF
      # default/zero position during arm-only planning, same as the fingers below).
      wx200/gripper_prop_link:
        - center: [0.0, 0.0, 0.0]
          radius: 0.013

      wx200/left_finger_link:
        - center: [-0.005, -0.003, 0.0]
          radius: 0.016
        - center: [0.035, -0.003, 0.0]
          radius: 0.016

      wx200/right_finger_link:
        - center: [-0.005, 0.003, 0.0]
          radius: 0.016
        - center: [0.035, 0.003, 0.0]
          radius: 0.016
