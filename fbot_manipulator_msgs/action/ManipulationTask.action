# Goal
uint8 PICK=0
uint8 PLACE=1
uint8 PICK_AND_PLACE=2
uint8 LOAD_CARGO=3
uint8 UNLOAD_CARGO=4

uint8 task_type

# Cargo selection index
uint8 cargo_index

# Which arm to use
string arm_name  # "left_arm" or "right_arm"

# Object info (from vision Detection3D bbox)
string object_id
geometry_msgs/Pose object_pose        # center of bounding box
geometry_msgs/Vector3 object_size     # bounding box dimensions (x, y, z)

# Target place pose (used for PLACE and PICK_AND_PLACE)
# Use either place_pose (geometric) or place_pose_name (SRDF named state)
geometry_msgs/Pose place_pose
string place_pose_name

---
# Result
bool success
string message

---
# Feedback
string current_stage
float32 progress
